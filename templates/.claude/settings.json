{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-main.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add .)",
      "Bash(git add -u *)",
      "Bash(git commit -a *)",
      "Bash(git commit -am *)",
      "Bash(git commit --all *)",

      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * +main)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",

      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",

      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh workflow disable *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh auth *)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(npm install -g *)",
      "Bash(npm install --global *)",
      "Bash(npm i -g *)",
      "Bash(npm i --global *)",
      "Bash(pnpm add -g *)",
      "Bash(yarn global *)",
      "Bash(pip install --user *)",
      "Bash(pip3 install --user *)",
      "Bash(python -m pip install --user *)",
      "Bash(python3 -m pip install --user *)",
      "Bash(brew install *)",
      "Bash(apt install *)",
      "Bash(apt-get install *)",
      "Bash(cargo install *)",
      "Bash(go install *)",

      "Bash(gh api *)",
      "Bash(git config --global *)"
    ]
  }
}
